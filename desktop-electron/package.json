{
  "name": "feonixai-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "FeonixAI",
  "author": "FeonixAI",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.feonixai.desktop",
    "productName": "FeonixAI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "FeonixAI Handoff",
        "schemes": [
          "feonixai"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "FeonixAI Setup ${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FeonixAI Setup ${version}.exe",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "FeonixAI-${version}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "FeonixAI listens to your microphone during interview sessions to transcribe questions and generate answers.",
        "NSAudioCaptureUsageDescription": "FeonixAI captures meeting audio during interview sessions to transcribe the interviewer’s questions."
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "FeonixAI-${version}.dmg"
    }
  }
}
